results/ads/runs/*/validation/
results/ads/runs/*/final/
results/ads/runs/*/result.json
results/ads/runs/*/repairs/**/training.json
results/ads/runs/*/repairs/**/training_losses.csv

# Current bridge: regenerable execution caches and compact runtime bank.
results/hierarchical_world_model/bridge/.cache/
!results/hierarchical_world_model/model_assets/interaction_errors.npz

# Published model packages; source manifests remain versioned.
ads/*/artifacts/*.tar.gz
ads/*/artifacts/*.part
