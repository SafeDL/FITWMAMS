results/hierarchical_world_model/npc_response/animations/higher_density_traffic.gif
results/hierarchical_world_model/npc_response/autonomous_traffic/continuous_runs/events.csv

# Small reports, configurations, figures and storage links remain versioned.
# Full numeric datasets and model bytes are excluded by the extensions above.
!results/ads/assets/runtime_reference/*.npz

# ADS protocols, frozen source, compact reports and handoff metadata are versioned.
# Keep large execution data and resumable learning state on disk, outside Git.
results/ads/runs/**/*.jsonl
results/ads/runs/**/*.sqlite*
results/ads/runs/**/*.lock
results/ads/runs/*/instances/
results/ads/runs/*/collection/
results/ads/runs/*/experts/phase_one/
results/ads/runs/*/experts/inputs/
results/ads/runs/*/training_diagnostics/
